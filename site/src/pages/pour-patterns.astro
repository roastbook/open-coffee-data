---
import Layout from "@roastbook/ui/astro/Layout.astro";
import { fieldUrl } from "@roastbook/ui/sites";
import NumberStepper from "@roastbook/ui/astro/NumberStepper.astro";
import KettlePath from "../components/KettlePath.astro";
import { siteNav } from "../lib/nav";
import PourChart from "../components/PourChart.astro";
import { brewMethods, buildDate, pourPatterns, version } from "../lib/data";
import { clock, phaseLabel, temperatureLines, timeline } from "../lib/pour";
import "../styles/pages.css";
import "../styles/pour.css";

const f = (path: string) => fieldUrl(path, "latest", "pour-patterns");
const byId = new Map(pourPatterns.map((p) => [p.id, p]));
const of = (kind: string) => pourPatterns.filter((p) => p.kind === kind);
const flows = of("flow"), recipes = of("recipe");
const methodName = (id: string) => brewMethods.find((m) => m.id === id)?.name ?? id;
const total = (p: any) => p.phases.reduce((s: number, x: any) => s + x.duration_seconds, 0);
const movesOf = (p: any) => [...new Set<string>(p.phases.map((x: any) => x.movement).filter(Boolean))].map((id) => byId.get(id)).filter(Boolean);
const moveUrl = (id: string) => `/kettle-movements/#${id}`;
const FLOW: Record<string, string> = { constant: "steady flow", ramp_up: "speeding up", ramp_down: "slowing down", custom: "varying flow" };
const AGITATION: Record<string, string> = { swirl: "swirl", gentle_swirl: "gentle swirl", stir: "stir", spin: "spin" };
---
<Layout title="Pour patterns" site="data" version={version} buildDate={buildDate} description="Open dataset of pour-over recipes and flow patterns, drawn as pour curves you can scale to any dose." nav={siteNav("pour-patterns")}>
  <header class="page-intro">
    <div>
      <h1>Pour patterns</h1>
      <p>How the water goes onto the coffee in pour-over brewing. Recipes are built on a ratio: pick your dose and every water target follows. Where the water lands is described under <a href="/kettle-movements/">Kettle movements</a>; the <a href={f("id").split("#")[0]}>schema</a> defines every field.</p>
    </div>
    <a class="button" href="/datasets/pour-patterns/pour-patterns.json">Download pour-patterns.json</a>
  </header>

  {pourPatterns.length === 0 ? <p class="muted">No pour patterns are published yet.</p> : (
    <>
      <div class="pour-legend" aria-hidden="true">
        <span><i class="key key-flow"></i>Flow from the kettle (g/s)</span>
        <span><i class="key key-poured"></i>Water poured (g)</span>
        <span><i class="key key-agitation"></i>Agitation</span>
      </div>

      <nav class="pour-toc" aria-label="On this page">
        <a href="#recipes">Recipes ({recipes.length})</a>
        <a href="#flow-patterns">Flow patterns ({flows.length})</a>
        <a href="/kettle-movements/">Kettle movements →</a>
      </nav>

      <section aria-labelledby="recipes">
        <h2 id="recipes">Recipes</h2>
        <p class="muted">Times follow the creators' published brews; when you change the dose they stay the same, as the creators keep their timings and adjust the grind. Temperatures are shown only as precisely as the creator gives them.</p>
        <div class="recipe-list">
          {recipes.map((r) => {
            const d = r.defaults;
            const segs = timeline(r.phases, d.brew_water_g);
            const temps = temperatureLines(d.temperature);
            return (
              <article class="pour-card recipe" id={r.id} data-dose={d.dose_g}>
                <header class="recipe-head">
                  <div>
                    <h3><a href={`#${r.id}`}>{r.name}</a></h3>
                    <p class="recipe-meta">{r.creator}{r.published_year && <> · {r.published_year}</>} · {r.brew_methods.map(methodName).join(", ")}{r.url && <> · <a href={r.url}>original recipe</a></>}</p>
                  </div>
                  <ul class="tags" aria-label="Flow patterns">
                    {r.flow_patterns.map((id: string) => <li><a class="badge" href={`#${id}`}>{byId.get(id)?.name ?? id}</a></li>)}
                  </ul>
                </header>
                <p class="recipe-desc">{r.description}</p>
                <div class="recipe-stats">
                  <div class="stat"><span class="stat-label">Ratio</span><span class="stat-value">1:{d.brew_ratio}</span></div>
                  <div class="stat"><label class="stat-label" for={`dose-${r.id}`}>Coffee</label><span class="stat-value"><NumberStepper class="dose" id={`dose-${r.id}`} min={1} max={200} step={0.5} value={d.dose_g} /> g</span></div>
                  <div class="stat"><span class="stat-label">Water</span><span class="stat-value"><span data-g={d.brew_water_g}>{d.brew_water_g}</span> g</span></div>
                  <div class="stat"><span class="stat-label">Time</span><span class="stat-value">{clock(total(r))}</span></div>
                  {d.grind_size && <div class="stat"><span class="stat-label">Grind</span><span class="stat-value">{d.grind_size.replaceAll("_", " ")}</span></div>}
                  <div class="stat stat-temp">
                    <span class="stat-label">Temperature</span>
                    {temps.length ? <span class="stat-list">{temps.map((t) => <span>{t}</span>)}</span> : <span class="stat-value muted">not given</span>}
                    {d.temperature?.note && <span class="stat-note">{d.temperature.note}</span>}
                  </div>
                </div>
                <div class="chart-scroll"><PourChart phases={r.phases} water={d.brew_water_g} label={r.name} width={1000} /></div>
                <div class="recipe-foot">
                  {movesOf(r).length > 0 && (
                    <ul class="moves" aria-label="Kettle movements">
                      {movesOf(r).map((m: any) => <li><KettlePath path={m.path} label={m.name} size={44} /><a href={moveUrl(m.id)}>{m.name}</a></li>)}
                    </ul>
                  )}
                </div>
                <details class="steps-details">
                  <summary>Step by step</summary>
                  <div class="table-scroll">
                    <table class="steps">
                      <thead><tr><th scope="col">Time</th><th scope="col">Step</th><th scope="col">Water</th><th scope="col">How</th></tr></thead>
                      <tbody>
                        {segs.map((s) => (
                          <tr>
                            <td>{clock(s.start)}–{clock(s.end)}</td>
                            <th scope="row">{phaseLabel(s.phase)}</th>
                            <td>{s.phase.type === "pour" ? <>+<span data-g={s.waterEnd - s.waterStart}>{Math.round(s.waterEnd - s.waterStart)}</span> g → <span data-g={s.waterEnd}>{Math.round(s.waterEnd)}</span> g</> : "—"}</td>
                            <td>{[s.phase.flow && FLOW[s.phase.flow], s.phase.movement && byId.get(s.phase.movement)?.name.toLowerCase(), ...(s.phase.agitation ?? []).map((a: string) => AGITATION[a]), s.phase.note].filter(Boolean).join("; ") || "—"}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      </section>

      <section aria-labelledby="flow-patterns">
        <h2 id="flow-patterns">Flow patterns</h2>
        <p class="muted">How the water is spread over time. Each is drawn from an example brew of {flows[0]?.defaults.dose_g ?? 15} g coffee and {flows[0]?.defaults.brew_water_g ?? 250} g water.</p>
        <div class="pour-grid">
          {flows.map((p) => (
            <article class="pour-card" id={p.id}>
              <h3><a href={`#${p.id}`}>{p.name}</a></h3>
              <p class="small">{p.description}</p>
              <PourChart phases={p.phases} water={p.defaults.brew_water_g} label={p.name} width={420} />
              <p class="muted small">Used in {recipes.filter((r) => r.flow_patterns.includes(p.id)).map((r) => r.name).join(", ") || "no recipe here yet"}.</p>
            </article>
          ))}
        </div>
      </section>
    </>
  )}
</Layout>

<script>
  import "../scripts/pour-page.ts";
  import "../scripts/kettle-motion.ts";
</script>
