---
import Layout from "@roastbook/open-coffee-ui/Layout.astro";
import Nav from "../components/Nav.astro";
import { buildDate, sources, version } from "../lib/data";
import "../styles/pages.css";
---
<Layout title="Sources" site="data" version={version} buildDate={buildDate} description="The allow-list of sources every Open Coffee record may cite, with licences and usage rules.">
  <Nav current="sources" />
  <h1>Sources</h1>
  <p class="lead">Every record cites its sources. Validation rejects any source that is not on this allow-list (<a href="/datasets/sources.json">sources.json</a>); adding one is a pull request reviewed by a maintainer.</p>
  <p>We never use Google Maps data (except storing a place id for verification), OpenStreetMap data, or the lists of closed guides and review sites. Ratings from other services appear only as links.</p>
  <div class="source-list">
    {sources.sources.map((s: any) => (
      <section class="card source" id={s.id} aria-labelledby={`h-${s.id}`}>
        <h2 id={`h-${s.id}`}>{s.url ? <a href={s.url}>{s.name}</a> : s.name}</h2>
        <p class="muted"><code>{s.id}</code> · {s.kind.replaceAll("_", " ")}</p>
        <dl class="facts">
          <div><dt>Licence</dt><dd>{s.licence}</dd></div>
          {s.attribution && <div><dt>Attribution</dt><dd>{s.attribution}</dd></div>}
          <div><dt>Allowed for</dt><dd>{s.allowed_for.map((a: string) => <span class="badge">{a}</span>)}</dd></div>
          <div><dt>Checked</dt><dd>{s.checked_at}{s.vetted ? " · vetted" : " · not vetted"}</dd></div>
        </dl>
        <p>{s.how_to_use}</p>
      </section>
    ))}
  </div>
  <p><a href="https://github.com/Roastbook/open-coffee-data/issues/new?template=propose-source.yml">Propose a source</a> (state its licence, terms and what it may be used for).</p>
</Layout>
