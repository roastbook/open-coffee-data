---
import Layout from "@roastbook/ui/astro/Layout.astro";
import { fieldUrl } from "@roastbook/ui/sites";
import Nav from "../components/Nav.astro";
import { buildDate, cities, places, version } from "../lib/data";
import { AMENITIES, SERVING } from "../scripts/fields";
import "maplibre-gl/dist/maplibre-gl.css";
import "../styles/explorer.css";
---
<Layout title="Explorer" site="data" version={version} buildDate={buildDate} description="Map and table of open coffee place data: specialty cafés, every field linked to its definition." canonical="https://data.roastbook.coffee/">
  <Nav current="explorer" />
  <header class="page-intro">
    <div>
      <h1>Coffee places</h1>
      <p>Explore the map, inspect the details or use the data in your own project.</p>
    </div>
    <a class="button" href="/downloads/">Download the data</a>
  </header>
  <ul class="dataset-summary" aria-label="Dataset overview">
    <li><strong>{places.length}</strong> coffee places</li>
    <li><strong>{cities.length}</strong> {cities.length === 1 ? "city" : "cities"}</li>
    <li><a href="/downloads/">Openly licensed</a><span>CDLA-Permissive-2.0</span></li>
  </ul>

  <div class="explorer" data-explorer>
    <form class="filters card" data-filters aria-label="Filter places" onsubmit="return false">
      <div class="filters-head">
        <h2 class="filters-title">Filters</h2>
        <button type="button" class="filters-toggle" data-filters-toggle aria-expanded="true" aria-controls="filters-body">Show filters</button>
        <button type="reset" class="link-button">Clear all</button>
      </div>
      <label class="field">
        <span>Search</span>
        <input type="search" name="q" placeholder="Search names, streets, roasters…" autocomplete="off" />
      </label>
      <div class="filters-body" id="filters-body">
      <label class="field">
        <span><a href={fieldUrl("address.locality")}>City</a></span>
        <select name="city">
          <option value="">All cities</option>
          {cities.map((c) => <option value={c.slug}>{c.name} ({c.country})</option>)}
        </select>
      </label>
      <fieldset>
        <legend><a href={fieldUrl("specialty_tier")}>Specialty tier</a></legend>
        <label class="check"><input type="checkbox" name="tier" value="A" /> <span class="tier-icon" data-tier="A" aria-hidden="true"></span> A · specialty-focused</label>
        <label class="check"><input type="checkbox" name="tier" value="B" /> <span class="tier-icon" data-tier="B" aria-hidden="true"></span> B · serves specialty</label>
        <label class="check"><input type="checkbox" name="tier" value="none" /> <span class="tier-icon" data-tier="other" aria-hidden="true"></span> Not specialty</label>
      </fieldset>
      <fieldset>
        <legend><a href={fieldUrl("status")}>Status</a></legend>
        {[["open", "Open"], ["temporarily_closed", "Temporarily closed"], ["closed", "Closed"], ["unverified", "Unverified"]].map(([v, l]) => (
          <label class="check"><input type="checkbox" name="status" value={v} /> {l}</label>
        ))}
      </fieldset>
      <fieldset>
        <legend>Coffee and shop</legend>
        <label class="check"><input type="checkbox" name="roasts" value="1" /> <a href={fieldUrl("roasts_own_beans")}>Roasts own beans</a></label>
        <label class="check"><input type="checkbox" name="equipment" value="1" /> <a href={fieldUrl("sells_equipment")}>Sells equipment</a></label>
      </fieldset>
      <details>
        <summary>Serving</summary>
        <fieldset>
          <legend class="visually-hidden">Serving</legend>
          {SERVING.map(([k, l]) => <label class="check"><input type="checkbox" name="serving" value={k} /> <a href={fieldUrl(`serving.${k}`)}>{l}</a></label>)}
        </fieldset>
      </details>
      <details>
        <summary>Amenities</summary>
        <fieldset>
          <legend class="visually-hidden">Amenities</legend>
          {AMENITIES.map(([k, l]) => <label class="check"><input type="checkbox" name="amenities" value={k} /> <a href={fieldUrl(`amenities.${k}`)}>{l}</a></label>)}
        </fieldset>
      </details>
      <label class="check"><input type="checkbox" name="inview" value="1" /> Only places in the map view</label>
      </div>
    </form>

    <section class="results" aria-label="Results">
      <div class="results-bar">
        <p class="results-count tabular" role="status" aria-live="polite" data-count>Loading places…</p>
        <div class="view-toggle" role="group" aria-label="View">
          <button type="button" data-view="map" aria-pressed="true">Map</button>
          <button type="button" data-view="table" aria-pressed="false">Table</button>
        </div>
      </div>
      <div class="panes" data-panes data-active="map">
        <div class="pane pane-map">
          <div class="map-toolbar">
            <p class="muted">Select a café for details. Zoom in for names.</p>
            <button type="button" data-show-all disabled>Show all results</button>
          </div>
          <div class="map-frame">
            <div class="map" data-map role="region" aria-busy="true" aria-label="Map of the filtered places. The table lists the same places for keyboard and screen reader use."></div>
            <div class="map-status" data-map-status>
              <p role="status" data-map-message>Loading map…</p>
              <div class="map-status-actions">
                <button type="button" data-map-retry hidden>Retry map</button>
                <button type="button" data-map-table>Use table instead</button>
              </div>
            </div>
          </div>
          <ul class="legend card" aria-label="Map legend">
            <li><span class="tier-icon" data-tier="A" aria-hidden="true"></span> Tier A</li>
            <li><span class="tier-icon" data-tier="B" aria-hidden="true"></span> Tier B</li>
            <li><span class="tier-icon" data-tier="other" aria-hidden="true"></span> Other</li>
            <li><span class="cluster-icon" aria-hidden="true">3</span> Group</li>
          </ul>
          <p class="map-note muted">Basemap © <a href="https://openfreemap.org/">OpenFreeMap</a>, <a href="https://openmaptiles.org/">OpenMapTiles</a>, data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>. The basemap is for display only; the coffee place dataset contains no OpenStreetMap data.</p>
        </div>
        <div class="pane pane-table">
          <div class="table-wrap">
            <table data-table>
              <caption class="visually-hidden">Filtered coffee places. Column headers sort; names open the details.</caption>
              <thead></thead>
              <tbody></tbody>
            </table>
          </div>
          <nav class="pager" aria-label="Table pages" data-pager></nav>
        </div>
      </div>
    </section>

    <aside class="detail card" data-detail hidden aria-labelledby="detail-title" tabindex="-1"></aside>
  </div>
  <noscript><p>The map and table need JavaScript. Download the data from the <a href="/downloads/">downloads page</a>.</p></noscript>
</Layout>

<script>
  import "../scripts/explorer";
</script>
