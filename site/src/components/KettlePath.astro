---
// Kettle movement seen from above: the coffee bed and the path the stream takes. scripts/kettle-motion.ts
// moves the pour point (.nozzle) along each segment in turn; without it, or with reduced motion, the full path shows.
import { pathPoints, svgPath, type PathSegment } from "../lib/pour";

export interface Props { path: PathSegment[]; label: string; size?: number }
const { path, label, size = 160 } = Astro.props;
const S = 80; // bed radius in SVG units
const sc = (v: number) => v * S;
---
<svg class="kettle-path" viewBox="-100 -100 200 200" width={size} height={size} role="img" aria-label={`${label}, seen from above`}>
  <circle r="96" class="dripper" />
  <circle r={S} class="bed" />
  <circle r="3" class="centre" />
  {path.map((seg, i) => {
    const pts = pathPoints(seg);
    const [cx, cy] = [sc(pts[0][0]), sc(pts[0][1])];
    return (
      <g class={`seg stream-${i % 3}`}>
        {pts.length === 1
          ? <circle cx={cx} cy={cy} r="7" class="ripple" />
          : <path d={svgPath(pts, sc, sc)} pathLength="100" class="trace" />}
        <circle cx={cx} cy={cy} r="7" class="nozzle" />
      </g>
    );
  })}
</svg>
