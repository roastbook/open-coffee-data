---
export interface Props { current: "explorer" | "downloads" | "brew-methods" }
const { current } = Astro.props;
const items = [
  ["explorer", "/", "Explorer"],
  ["downloads", "/downloads/", "Downloads"],
  ["brew-methods", "/brew-methods/", "Brew methods"],
] as const;
---
<nav class="subnav" aria-label="Data Explorer">
  {items.map(([id, href, label]) => <a href={href} aria-current={id === current ? "page" : undefined}>{label}</a>)}
</nav>
<style>
  .subnav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: -0.5rem 0 1.75rem; border-bottom: 1px solid var(--border); }
  .subnav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0.25rem 0.25rem 0.75rem; border-bottom: 2px solid transparent; color: var(--muted-foreground); text-decoration: none; font-weight: 600; font-size: 0.9375rem; }
  .subnav a:hover { color: var(--foreground); border-color: var(--input); }
  .subnav a[aria-current="page"] { border-color: var(--primary); color: var(--link); }
</style>
